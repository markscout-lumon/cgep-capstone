        "type": "service",
        "title": "Acme Health patient-intake API with GRC wrap",
        "description": "Inherited CGE-P starter (API Gateway HTTP API, Lambda, DynamoDB, S3 uploads, VPC) plus the HIPAA/800-66 controls wrapped around it: customer CMK, TLS-deny bucket policy, versioning, Lambda VPC placement, Object Lock evidence vault, CloudTrail, and a GitHub Actions plan/policy/apply/sign/upload gate.",
        "purpose": "Ingest patient-intake submissions over HTTPS and store PHI only under the controls selected in oscal/profiles/cge-p-minimum.json.",
        "responsible-roles": [
          {
            "role-id": "provider",
            "party-uuids": ["8ff11e04-be9d-4096-8428-323f0c987cbb"]
          }
        ],
